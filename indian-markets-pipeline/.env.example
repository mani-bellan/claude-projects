# DuckDB warehouse path (relative to project root)
DUCKDB_PATH=data/markets.duckdb

# Schema registry path
SCHEMA_REGISTRY_PATH=data/schema_registry.json

# Universe size: NIFTY_50 | NIFTY_500 | CUSTOM
STOCK_UNIVERSE=NIFTY_500

# Backfill window (years)
BACKFILL_YEARS=20

# Failure triage with Jev: get a key at https://console.typesafe.ai/keys (never commit it)
TYPESAFE_API_KEY=
# shadow: only record decisions in data/triage_log.jsonl | act: also stop pointless retries
TRIAGE_MODE=shadow

# Airflow
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
