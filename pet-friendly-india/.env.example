# Google Places API (New) — needed for live ingestion.
# allowsDogs requires the Place Details Enterprise + Atmosphere SKU.
GOOGLE_MAPS_API_KEY=

# Anthropic API — needed for LLM evidence extraction from review text.
ANTHROPIC_API_KEY=

# Path to the DuckDB database file (default shown).
PFI_DB_PATH=data/petfriendly.duckdb
