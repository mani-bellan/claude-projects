# ossie-duck reads these from your shell environment. It does NOT load .env files by itself.
# To use this file:  cp .env.example .env   then edit .env   then run:  set -a; source .env; set +a
# Never commit the real .env (it is git-ignored).

# Keys that callers must send to the REST API / MCP-over-HTTP server (comma-separated, 16+ characters each).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
OSSIE_DUCK_API_KEYS=

# Only for the optional `ossie-duck ask` command.
ANTHROPIC_API_KEY=
# OSSIE_DUCK_MODEL=
